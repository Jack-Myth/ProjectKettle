<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Kettle/Kettle.csproj" />
    <Compile Include="../Kettle.Checks/*.cs" Exclude="../Kettle.Checks/Program.cs" Link="Shared/%(Filename)%(Extension)" />
    <None Include="../Kettle.Checks/Fixtures/*.json" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Kettle.Checks/Fixtures/*.txt" Link="Fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../TerminalHost.targets" />
</Project>
