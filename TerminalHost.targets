<Project>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)src/Kettle.TerminalHost/Kettle.TerminalHost.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishAot;PublishTrimmed" />
  </ItemGroup>
  <Target Name="CopyTerminalHost" AfterTargets="Build">
    <ItemGroup>
      <HostFiles Include="$(MSBuildThisFileDirectory)src/Kettle.TerminalHost/bin/$(Configuration)/net10.0/Kettle.TerminalHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(HostFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishTerminalHost" AfterTargets="Publish">
    <PropertyGroup>
      <TerminalHostPublishDir>$(MSBuildThisFileDirectory)src/Kettle.TerminalHost/bin/$(Configuration)/terminal-publish/$(RuntimeIdentifier)/</TerminalHostPublishDir>
      <TerminalHostRuntimeArgument Condition="'$(RuntimeIdentifier)' != ''">-r $(RuntimeIdentifier)</TerminalHostRuntimeArgument>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)src/Kettle.TerminalHost/Kettle.TerminalHost.csproj&quot; -c $(Configuration) $(TerminalHostRuntimeArgument) -p:PublishAot=$(PublishAot) -p:OptimizationPreference=$(OptimizationPreference) -p:Optimize=$(Optimize) -p:DebugType=$(DebugType) -p:DebugSymbols=$(DebugSymbols) -p:ServerGarbageCollection=$(ServerGarbageCollection) -p:ConcurrentGarbageCollection=$(ConcurrentGarbageCollection) -o &quot;$(TerminalHostPublishDir)&quot;" />
    <ItemGroup>
      <HostPublishFiles Include="$(TerminalHostPublishDir)Kettle.TerminalHost.exe" Condition="'$(PublishAot)' == 'true'" />
      <HostPublishFiles Include="$(TerminalHostPublishDir)Kettle.TerminalHost.*" Exclude="$(TerminalHostPublishDir)*.pdb" Condition="'$(PublishAot)' != 'true'" />
      <HostPublishFiles Include="$(TerminalHostPublishDir)Kettle.TerminalHost.pdb" Condition="'$(DebugSymbols)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(HostPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
