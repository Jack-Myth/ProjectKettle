<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Kettle.MainWindow" xmlns:local="using:Kettle" xmlns:core="using:Kettle.Core" x:DataType="local:MainViewModel" Title="{local:Tr Key=KettleLibrary}" Width="880" Height="600" MinWidth="760" MinHeight="500" CanResize="True" WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button"><Setter Property="Padding" Value="12,7" /></Style>
    <Style Selector="TextBox"><Setter Property="Padding" Value="10,6" /></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="8" /><Setter Property="Margin" Value="0,2" /></Style>
  </Window.Styles>
  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="164,*">
      <Border Background="#151C24" BorderBrush="#27313D" BorderThickness="0,0,1,0" Padding="14,18,14,14">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Background="#64DBBC" Width="34" Height="34" CornerRadius="8">
              <TextBlock Text="K" FontSize="21" FontWeight="Bold" Foreground="#12362C" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="KETTLE" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center" LetterSpacing="2" />
          </StackPanel>
          <StackPanel Grid.Row="1" Spacing="10" Margin="0,26,0,0">
            <TextBlock Text="{local:Tr Key=YourSpace}" Classes="muted" FontSize="11" />
            <Button x:Name="InstalledHomeButton" Content="{local:Tr Key=Installed}" Classes="nav active" Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" />
          </StackPanel>
          <StackPanel Grid.Row="3" Spacing="10">
            <Button x:Name="PlayerButton" IsEnabled="{Binding !LoggingOut}" Background="#202E37" Padding="8,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{local:Tr Key=PlayerMenu}">
              <Button.Flyout>
                <MenuFlyout Placement="Top">
                  <MenuItem x:Name="SettingsMenuButton" MinWidth="148" Header="{local:Tr Key=Settings}" Command="{Binding OpenSettingsCommand}" />
                  <MenuItem x:Name="LogoutMenuButton" MinWidth="148" Header="{local:Tr Key=LogOut}" Command="{Binding LogoutCommand}" />
                </MenuFlyout>
              </Button.Flyout>
              <Grid ColumnDefinitions="32,*,Auto">
                <Border Background="#31514B" Width="30" Height="30" CornerRadius="15">
                  <TextBlock Text="{Binding PlayerMonogram}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A0E3CC" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" Margin="9,0,3,0">
                  <TextBlock Text="{Binding PlayerTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding PlayerTitle}" />
                  <TextBlock Text="{Binding PlayerCaption}" Classes="muted" FontSize="10" />
                </StackPanel>
                <Path Grid.Column="2" Data="M 0,5 L 4,1 L 8,5" Width="8" Height="6" Stroke="#8E9BAA" StrokeThickness="1.3" VerticalAlignment="Center" />
              </Grid>
            </Button>
            <TextBlock Text="Kettle 0.11" Classes="muted" FontSize="10" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" IsVisible="{Binding IsLibraryContentVisible}" RowDefinitions="Auto,Auto,*,Auto" Margin="16,16,16,10">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
          <StackPanel Spacing="7">
            <TextBlock Text="LIBRARY" Classes="eyebrow" />
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="SemiBold" />
          </StackPanel>
          <Border Grid.Column="1" Background="#26352E" CornerRadius="20" Padding="10,6" VerticalAlignment="Center">
            <TextBlock Text="{Binding ModeLabel}" Foreground="#B2D7BE" FontSize="11" />
          </Border>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,10">
          <Border IsVisible="{Binding DiagnosticEnabled}" Background="#253631" CornerRadius="8" Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="{local:Tr Key=TemporaryLBLaunchDiagnosticsAppID}" FontWeight="SemiBold" />
              <TextBlock Text="{local:Tr Key=UsesThisLoginSessionOnlyBacksUpSavesThen}" TextWrapping="Wrap" FontSize="11" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="{local:Tr Key=BackUpAndStartLBDiagnostics}" Command="{Binding StartDiagnosticCommand}" />
                <Button Content="{local:Tr Key=RecheckExitStatus}" Command="{Binding RecheckDiagnosticCommand}" />
                <Button Content="{local:Tr Key=EndDiagnosticsSafelyAndReturnToLogin}" Command="{Binding EndDiagnosticCommand}" />
              </StackPanel>
              <TextBlock Text="{Binding DiagnosticMessage}" TextWrapping="Wrap" FontSize="11" />
            </StackPanel>
          </Border>
          <TextBlock IsVisible="{Binding IsPreview}" Text="{Binding SourceDescription}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          <Border x:Name="ConnectionRecoveryBanner" IsVisible="{Binding HasConnectionIssue}" Background="#392E20" CornerRadius="8" Padding="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding ConnectionIssue}" TextWrapping="Wrap" FontSize="12" Foreground="#F0CC97" VerticalAlignment="Center" Margin="0,0,12,0" />
              <Button x:Name="ReconnectButton" Grid.Column="1" IsVisible="{Binding ShowReconnect}" Content="{Binding ReconnectLabel}" Command="{Binding ReconnectCommand}" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
            <TextBox x:Name="LibrarySearch" IsEnabled="{Binding CanSelectGame}" Height="36" VerticalContentAlignment="Center" Text="{Binding Search}" Watermark="{local:Tr Key=SearchNameOrAppID}" AutomationProperties.Name="{local:Tr Key=SearchGames}" />
            <ComboBox x:Name="LibrarySort" IsEnabled="{Binding CanSelectGame}" Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="12,0" Margin="8,0" MinWidth="116" />
            <Button Grid.Column="2" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="{local:Tr Key=Refresh}" Command="{Binding RefreshCommand}" />
          </Grid>
          <Border Background="#382E21" CornerRadius="8" Padding="10" IsVisible="{Binding HasNotice}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" Foreground="#EBCB94" FontSize="11" MaxHeight="70" />
          </Border>
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="1.2*,12,0.95*">
          <Border Classes="card" Padding="12">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="11" Margin="7,0,0,8" />
              <ListBox x:Name="InstalledGameList" Grid.Row="1" IsEnabled="{Binding CanSelectGame}" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="{local:Tr Key=LocalGameList}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="core:Game">
                    <Grid ColumnDefinitions="36,*">
                      <Border Background="#2D444B" Width="34" Height="40" CornerRadius="7">
                        <TextBlock Text="{Binding Monogram}" FontWeight="SemiBold" FontSize="23" Foreground="#98CFC4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding AppLabel}" Classes="muted" FontSize="10" />
                          <TextBlock Text="{Binding State}" Foreground="#83C8AE" FontSize="10" />
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="15">
                <TextBlock Text="{Binding EmptyTitle}" FontSize="18" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" MaxWidth="260" Classes="muted" TextAlignment="Center" FontSize="12" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="*,Auto" IsVisible="{Binding HasSelection}">
              <ScrollViewer x:Name="GameDetailsScroll">
                <StackPanel>
                  <Viewbox x:Name="HeaderFrame" Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch">
                    <Border Width="460" Height="215" Background="#243640" ClipToBounds="True">
                      <Grid>
                        <StackPanel Spacing="8" Margin="24" VerticalAlignment="Center" IsVisible="{Binding !HasHeader}">
                          <TextBlock Text="{Binding SelectedGame.Monogram}" FontSize="42" FontWeight="SemiBold" Foreground="#70AFA4" />
                          <TextBlock Text="{Binding HeaderMessage}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <Image Source="{Binding HeaderImage}" IsVisible="{Binding HasHeader}" Stretch="Uniform" />
                      </Grid>
                    </Border>
                  </Viewbox>
                  <StackPanel Spacing="10" Margin="12">
                    <StackPanel Spacing="8">
                      <TextBlock Text="{Binding SelectedGame.Name}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="24" />
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding SelectedGame.State}" Foreground="#83C8AE" FontSize="12" />
                        <TextBlock Text="{Binding SelectedGame.AppLabel}" Classes="muted" FontSize="10" VerticalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                    <Border Background="#121D25" CornerRadius="8" Padding="12">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{local:Tr Key=InstalledSize}" Classes="muted" FontSize="10" />
                        <TextBlock Text="{Binding DetailSize}" FontSize="23" FontWeight="SemiBold" />
                      </StackPanel>
                    </Border>
                    <StackPanel Spacing="8">
                      <TextBlock Text="{local:Tr Key=InstallLocation}" Classes="muted" FontSize="10" />
                      <SelectableTextBlock Text="{Binding SelectedGame.InstallPath}" FontSize="11" TextWrapping="Wrap" Foreground="#BAC9D5" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="1" Margin="12,8,12,12" Spacing="10">
                <TextBlock x:Name="CloudSyncStatus" IsVisible="{Binding IsCloudSyncing}" Text="{Binding OperationMessage}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Foreground="#74BCFF" ToolTip.Tip="{Binding OperationMessage}" />
                <Button x:Name="OperationIssueButton" IsVisible="{Binding HasOperationIssue}" Content="{Binding IssueLabel}" Command="{Binding OperationIssueCommand}" HorizontalAlignment="Stretch" Foreground="#E6BD83" />
                <Grid ColumnDefinitions="*,46">
                  <Button x:Name="RunGameButton" Height="36" Content="{Binding RunLabel}" Command="{Binding RunCommand}" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
                  <Button x:Name="MoreGameButton" Grid.Column="1" Height="36" MinWidth="0" HorizontalAlignment="Stretch" Content="⋯" Margin="8,0,0,0" Padding="8" HorizontalContentAlignment="Center" AutomationProperties.Name="{local:Tr Key=GameActions}">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem x:Name="OpenInstallFolderMenuItem" Header="{local:Tr Key=OpenInstallFolder}" Command="{Binding OpenFolderCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsWorking}" Height="2" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding LibraryStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="{local:Tr Key=CancelReading}" IsVisible="{Binding IsWorking}" Command="{Binding CancelLibraryCommand}" Padding="10,3" FontSize="11" />
          </Grid>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" IsVisible="{Binding IsSettingsOpen}" RowDefinitions="Auto,*" Margin="16,16,16,12">
        <StackPanel Spacing="8" Margin="0,0,0,12">
          <Button x:Name="SettingsBackButton" Command="{Binding CloseSettingsCommand}" Background="Transparent" Padding="0,5" Foreground="#9BAFBC" HorizontalAlignment="Left" AutomationProperties.Name="{local:Tr Key=BackToGames}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="M 5,1 L 1,5 L 5,9 M 1,5 L 13,5" Width="14" Height="10" Stroke="#9BAFBC" StrokeThickness="1.3" VerticalAlignment="Center" />
              <TextBlock Text="{local:Tr Key=BackToGames}" Foreground="#9BAFBC" />
            </StackPanel>
          </Button>
          <TextBlock Text="{local:Tr Key=Settings}" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="{Binding SettingsMessage}" Foreground="#EBCB94" FontSize="11" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
          <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Stretch">
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="{local:Tr Key=Language}" FontSize="18" FontWeight="SemiBold" />
                <ComboBox x:Name="LanguageSelector" ItemsSource="{Binding LanguageOptions}" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" MinWidth="240" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{local:Tr Key=PlayerInformation}" FontSize="18" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="{local:Tr Key=Nickname}" Classes="muted" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{Binding PlayerNickname}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="{local:Tr Key=AccountName}" Classes="muted" FontSize="12" Margin="0,8,0,0" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PlayerAccount}" Margin="0,8,0,0" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="2" Text="SteamID" Classes="muted" FontSize="12" Margin="0,8,0,0" />
                  <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PlayerSteamId}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </Grid>
                <TextBlock Text="{Binding ProfileMessage}" Classes="muted" FontSize="11" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{local:Tr Key=SteamCMDPathAndLibraries}" FontSize="18" FontWeight="SemiBold" />
                <SelectableTextBlock Text="{Binding SteamCmdLocation}" FontSize="11" TextWrapping="Wrap" />
                <TextBlock Text="{local:Tr Key=LibraryChangesTakeEffectAfterLoggingInAgain}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                <ListBox ItemsSource="{Binding Libraries}" SelectedItem="{Binding SelectedLibrary}" MinHeight="70" MaxHeight="180" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:LibraryEntry">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Root}" TextWrapping="Wrap" FontSize="12" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                          <TextBlock Text="{Binding Source}" Classes="muted" FontSize="10" />
                          <TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <Button x:Name="AddLibraryButton" Content="{local:Tr Key=AddLibrary}" Command="{Binding AddLocalLibraryCommand}" />
                  <Button x:Name="RemoveLibraryButton" Content="{local:Tr Key=RemoveRegistration}" Command="{Binding RemoveLibraryCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding LocalLibraryMessage}" Foreground="#9BD8C3" FontSize="12" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Classes="card" Padding="16">
              <StackPanel Spacing="8">
                <TextBlock Text="{local:Tr Key=AboutKettle}" FontWeight="SemiBold" />
                <TextBlock Text="{local:Tr Key=LightweightSteamGameLauncherBasedOnSteamCMD}" TextWrapping="Wrap" Classes="muted" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
    <Border Grid.Row="1" Background="#10151C" BorderBrush="#26313C" BorderThickness="0,1,0,0" Padding="16,6">
      <TextBlock Text="{Binding DataLocation}" Foreground="#67798D" FontSize="10" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
