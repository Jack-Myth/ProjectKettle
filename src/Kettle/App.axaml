<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Kettle.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI, sans-serif" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Background" Value="#101419" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E9EEF4" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#8E9BAA" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="Foreground" Value="#64DBBC" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="2" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="18,11" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#64DBBC" />
      <Setter Property="Foreground" Value="#102820" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#39414A" />
      <Setter Property="Foreground" Value="#8F99A3" />
    </Style>
    <Style Selector="Button.primary:enabled:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#8BEACF" />
      <Setter Property="Foreground" Value="#102820" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="Background" Value="#121A23" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#19212B" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BorderBrush" Value="#2B3542" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,3" />
      <Setter Property="CornerRadius" Value="10" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#294C45" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#9DAFBC" />
    </Style>
    <Style Selector="Button.nav.active">
      <Setter Property="Background" Value="#263C39" />
      <Setter Property="Foreground" Value="#79DFC2" />
    </Style>
    <Style Selector="ListBox.compact ListBoxItem">
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="CornerRadius" Value="5" />
    </Style>
  </Application.Styles>
</Application>
