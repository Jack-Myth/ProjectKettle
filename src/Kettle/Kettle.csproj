<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kettle</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Size</OptimizationPreference>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <ProjectReference Include="..\Kettle.Core\Kettle.Core.csproj" />
  </ItemGroup>
  <Import Project="../../TerminalHost.targets" />
  <Import Project="../../CloudHost.targets" />
  <!-- Program selects Software rendering exclusively; ANGLE is not used. -->
  <Target Name="ExcludeSoftwareRenderingUnusedNativeLibrary" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'av_libglesv2.dll'" />
    </ItemGroup>
    <Delete Files="$(PublishDir)av_libglesv2.dll" />
  </Target>
</Project>
